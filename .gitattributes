# 默认按文本处理，仓库内统一存 LF
* text=auto eol=lf

# 明确声明为文本
*.html text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.py   text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary